# Copy to .env for local development. Never commit .env or real credentials.

# PostgreSQL used by the API and the migrator (matches infrastructure/docker-compose.yml).
ConnectionStrings__Database='Host=localhost;Port=5432;Database=fandom_score;Username=fandom;Password=change-me-locally'

# Password for the local docker-compose database. Use the same value in the connection string above.
POSTGRES_PASSWORD=change-me-locally

# Access-token signing key: base64 of at least 32 random bytes. Generate your own: openssl rand -base64 32
Auth__SigningKey=

# OAuth client IDs whose identity tokens the API accepts (comma-separated). Empty disables the provider.
# Apple: iOS bundle ID first (used to revoke Apple sign-ins), then the Services ID.
# Google: iOS, Android, and web client IDs.
Auth__Apple__ClientIds=
Auth__Google__ClientIds=

# Local developer sign-in for the app (any test name, no Google account). Development environment only:
# the API refuses to start with it anywhere else. Anyone who can reach the API can sign in as anyone.
Auth__DevSignIn=true

# The API's public URL, used for every absolute link it hands out (signed file links, score cards). Required outside
# Development; locally, leave it empty to use the address the request came to (e.g. your LAN IP for a phone).
App__PublicOrigin=

# Browser origins allowed to call the API (comma-separated): the Expo web dev server, or your tunnel URL.
Cors__AllowedOrigins=http://localhost:8081,http://127.0.0.1:8081

# Sign in with Apple key, used to revoke a user's Apple sign-in when they delete their account.
# From the Apple Developer account (Keys). The private key is the .p8 file's PEM text and is a secret.
Auth__Apple__TeamId=
Auth__Apple__KeyId=
Auth__Apple__PrivateKey=

# Spotify (API and worker). Client ID from the Spotify developer dashboard; not a secret. Empty disables Spotify.
Spotify__ClientId=
# Client secret from the same dashboard page. Secret. Used only for artist search and add (app token).
# Empty turns those off; connecting a user's Spotify does not need it.
Spotify__ClientSecret=
# Comma-separated redirect URIs the app may send. Register each one in the Spotify dashboard too.
Spotify__RedirectUris=
# Encrypts stored Spotify refresh tokens: base64 of 32 random bytes. Secret. Generate: openssl rand -base64 32
# When rotating, move the old key to Spotify__PreviousTokenKeys (comma-separated) until every user has synced.
Spotify__TokenKey=
Spotify__PreviousTokenKeys=

# Apple Music and Tidal (API and worker; ADR 0007). Stored tokens are encrypted with Spotify__TokenKey above.
# Apple Music: a MusicKit key from the Apple Developer account (Keys, "Media Services"). The private key is the .p8
# file's PEM text and is a secret. All three empty disables Apple Music.
MusicProviders__AppleMusic__TeamId=
MusicProviders__AppleMusic__KeyId=
MusicProviders__AppleMusic__PrivateKey=
# Tidal: client ID from the TIDAL developer dashboard (not a secret; PKCE, no client secret) and the redirect URIs
# the app may send, comma-separated, each registered in the dashboard too. Empty client ID disables Tidal.
MusicProviders__Tidal__ClientId=
MusicProviders__Tidal__RedirectUris=

# Ticketmaster Discovery API (worker): loads tracked artists' upcoming shows, sale dates, and presales. Secret.
# Key from developer.ticketmaster.com. Empty turns concert syncing off.
Ticketmaster__ApiKey=

# Printed order numbers on proof photos (worker, workers/image-redaction/README.md): the Tesseract executable to run,
# e.g. tesseract (on PATH) or /usr/bin/tesseract. Empty keeps OCR off (the chiseled worker image has no Tesseract).
Redaction__TesseractCommand=

# Push notifications through Expo (worker). On by default; false stops pushes (in-app notifications stay).
Push__Enabled=true
# Only needed if "enhanced push security" is turned on for the Expo project. Secret.
Push__ExpoAccessToken=

# Staff notices by email (worker; workers/notifications/README.md). Off by default: no provider is chosen yet. To see
# the emails locally, set Enabled=true with Provider=log (each email goes to the worker's log), a From address, and
# the web app's origin for the link in each email.
Email__Enabled=false
Email__Provider=log
Email__From=Fandom Score <no-reply@example.test>
Email__AppOrigin=http://localhost:8081

# Retention periods still to be decided (worker; workers/README.md "Retention"). Unset keeps the records, as today.
# Retention__ReadNotifications=180.00:00:00
# Retention__Notifications=365.00:00:00
# Retention__ClickLinks=365.00:00:00
# Retention__OcrText=30.00:00:00

# Stored files (API and worker): local (disk, default) or gcs (Cloud Storage; packages/storage/README.md).
# Locally the worker must use the API's directory: the absolute path of services/api/.local-storage.
Storage__Provider=local
# Storage__LocalPath=/absolute/path/to/services/api/.local-storage
# gcs only: bucket names (terraform output buckets), and an emulator address for local runs (no credentials).
Storage__QuarantineBucket=
Storage__ArchiveBucket=
Storage__MediaBucket=
Storage__EmulatorHost=

# Worker job kinds (comma-separated). Empty runs every kind, which is what you want locally. In the cluster the
# redaction Deployment sets OnlyKinds and the worker ExceptKinds (workers/README.md). Set at most one.
Jobs__OnlyKinds=
Jobs__ExceptKinds=
