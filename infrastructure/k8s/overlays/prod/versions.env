# Version of each component in prod: `auto` (the last commit that changed what its images are built from) or a
# commit to hold it at (a rollback; its images must be in the registry). Read by versions.sh, which lists the paths.
# Rolling back one component: set its line to the commit it ran before (deploy log, or kubectl get deploy -o wide),
# commit, push. Back to normal: `auto`. infrastructure/README.md, "Deploying".
backend=auto        # api, worker (and redaction), migrate: one build
web=auto            # fan web app (apps/mobile)
promoter-web=auto   # promoter dashboard (apps/promoter-web)
