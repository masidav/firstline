# The web apps' server (fan app and promoter dashboard; Dockerfile targets web and promoter-web). The image's
# entrypoint fills in ${API_URL} and the other settings from the environment at startup (Kubernetes ConfigMap
# web-config), so the same image serves beta and prod.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types application/javascript text/css application/json image/svg+xml;

    # Kubernetes probes and the load balancer's health check.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Read by the app before it starts (src/config.ts). Not secrets: client IDs and the API address.
    location = /config.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        default_type application/javascript;
        return 200 'window.__FANDOM_CONFIG__ = {"apiUrl": "${API_URL}", "devSignIn": ${DEV_SIGN_IN}, "googleWebClientId": "${GOOGLE_WEB_CLIENT_ID}", "spotifyClientId": "${SPOTIFY_CLIENT_ID}"};\n';
    }

    # Build output with content hashes in the names (Vite's assets/, Expo's _expo/static/): safe to cache for good.
    location ~ ^/(assets|_expo)/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything else: the file if there is one, otherwise index.html (the apps route on the client). index.html is
    # never cached, so a deploy shows at once, and gets the /config.js script ahead of the app's own.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
        sub_filter '</head>' '<script src="/config.js"></script></head>';
        sub_filter_once on;
    }
}
