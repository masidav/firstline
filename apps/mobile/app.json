{
  "expo": {
    "name": "Fandom Score",
    "slug": "fandom-score",
    "scheme": "fandomscore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fandom Score uses the photos you choose to post tickets, merch, and concert pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0f1115"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.firstline.fandomscore",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.firstline.fandomscore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#0f1115"
      }
    }
  }
}
