{
  "expo": {
    "name": "Fandom Score",
    "slug": "fandom-score",
    "scheme": "fandomscore",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fandom Score uses the photos you choose to post tickets, merch, and concert pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
