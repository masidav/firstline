{
  "expo": {
    "name": "FirstLine",
    "slug": "fandom-score",
    "scheme": "fandomscore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": { "policy": "appVersion" },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fandom Score uses the photos you choose to post tickets, merch, and concert pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FirstLine uses your location, only when you ask, to confirm you're near your hub city so fans in a show's city get first pick.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0f1115"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.firstline.fandomscore",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSAppleMusicUsageDescription": "FirstLine reads your Apple Music library and listening history, only for artists you follow here, to measure your fandom."
      }
    },
    "android": {
      "package": "com.firstline.fandomscore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#0f1115"
      }
    }
  }
}
