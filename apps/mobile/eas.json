{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DEV_SIGN_IN": "true"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "beta": {
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.beta.firstline-5730kl.com/v1",
        "EXPO_PUBLIC_DEV_SIGN_IN": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.example.com/v1",
        "EXPO_PUBLIC_DEV_SIGN_IN": "false"
      }
    }
  },
  "submit": {
    "beta": {},
    "production": {}
  }
}
