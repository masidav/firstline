# Copy to .env.local for local development. Every EXPO_PUBLIC_ value ends up in the app bundle,
# so never put secrets here.

# The API's /v1 base URL. Use the tunnel URL when testing on a phone (see README).
EXPO_PUBLIC_API_URL=http://localhost:5271/v1

# Show the developer sign-in (needs Auth__DevSignIn=true on an API running in Development).
EXPO_PUBLIC_DEV_SIGN_IN=true

# Spotify app client ID (same as the API's Spotify__ClientId; not a secret). Empty hides "Connect Spotify".
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Google OAuth client IDs (not secrets). The API must list the same IDs in Auth__Google__ClientIds.
# Web: a "Web application" client with http://localhost:8081 as an authorized JavaScript origin and
# http://localhost:8081/google-callback as an authorized redirect URI (plus your tunnel URL). Empty hides the button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: an "iOS" client for the app's bundle ID; its reversed form goes in app.json under "scheme". Native app only.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
