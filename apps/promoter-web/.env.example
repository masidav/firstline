# Copy to .env.local for local development. Every VITE_ value ends up in the bundle, so never put secrets here.

# The API's /v1 base URL. Add this dashboard's origin (http://localhost:5173) to the API's Cors__AllowedOrigins.
VITE_API_URL=http://localhost:5271/v1

# Show the developer sign-in (needs Auth__DevSignIn=true on an API running in Development).
VITE_DEV_SIGN_IN=true

# Google OAuth web client ID (the API must list it in Auth__Google__ClientIds). Register
# http://localhost:5173/google-callback as an authorized redirect URI. Empty hides "Continue with Google".
VITE_GOOGLE_WEB_CLIENT_ID=
