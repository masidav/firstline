# Build context for the root Dockerfile: what the .NET projects and the two web apps need.
.git
.github
.claude
**/bin
**/obj
**/TestResults
docs
tests
tools
!tools/dev/seed.py
!tools/dev/spotify_connect.py
!tools/testkit
testScripts
infrastructure
*.md
*.txt
# Env files anywhere (a developer's local settings must never reach an image), and local build output.
**/.env*
**/.local-storage
apps/*/node_modules
apps/*/dist
apps/*/.expo
apps/*/e2e/.web
apps/*/e2e/test-results
apps/*/e2e/playwright-report
